# APIキー（.env にコピーして値を入れてください。.env はGitにコミットされません）
FISH_API_KEY=
GEMINI_API_KEY=

# モデル
GEMINI_MODEL=gemini-3.5-flash-lite
FISH_MODEL=s2.1-pro-free

# Fish Audio の声モデルID（https://fish.audio で好きな声のページURL末尾のID）。空ならデフォルト音声
FISH_VOICE_ID=

# 公開時の合言葉。設定すると知っている人だけが使える（Vercelでは設定を強く推奨）
APP_PASSWORD=

PORT=3000
